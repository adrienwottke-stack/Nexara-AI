# Kopieren nach .env (wird nicht committet) und Werte eintragen.
# Ziel des Anfrageformulars. Leer = eigener Cloudflare Worker unter /api/anfrage (empfohlen).
VITE_LEAD_ENDPOINT=

# Google Ads (leer = kein Tracking, kein Cookie-Hinweis).
# Konto-ID im Format AW-1234567890 und die Conversion-Labels aus Google Ads > Ziele > Conversions.
VITE_GADS_ID=
VITE_GADS_LABEL_LEAD=
VITE_GADS_LABEL_BOOKING=
