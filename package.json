{
  "name": "adrien-wottke-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-automation-pages.mjs && vite build",
    "preview": "vite preview",
    "frames": "node scripts/extract-frames.mjs",
    "pages": "node scripts/build-automation-pages.mjs",
    "cf:setup": "node scripts/cf-setup.mjs",
    "cf:domain": "node scripts/cf-setup.mjs --domain",
    "cf:dev": "npm run build && wrangler dev --port 8787",
    "cf:deploy": "node scripts/cf-deploy.mjs",
    "cf:deploy:arbeitsstand": "npm run build && wrangler deploy",
    "cf:check": "node scripts/cf-check.mjs",
    "db:migrate:local": "wrangler d1 migrations apply nexara --local",
    "db:migrate": "wrangler d1 migrations apply nexara --remote",
    "db:anfragen": "wrangler d1 execute nexara --remote --command \"SELECT id, zeit, unternehmen, email, branche, weitergeleitet FROM anfragen ORDER BY id DESC LIMIT 20\"",
    "db:wartend": "wrangler d1 execute nexara --remote --command \"SELECT id, name, gemeinde, status, erstellt_am FROM eintraege WHERE status IN ('unbestaetigt','wartend') ORDER BY id DESC\""
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "@fontsource/anton": "^5.1.0",
    "gsap": "^3.12.5",
    "lenis": "^1.1.18"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.168.0"
  }
}
